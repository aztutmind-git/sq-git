# Copy this file to `.env` and fill in real values.

# ---- PostgreSQL ----
DATABASE_URL=postgresql+psycopg2://syllabusquest:syllabusquest@localhost:5432/syllabusquest

# ---- Auth ----
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
RESET_TOKEN_EXPIRE_MINUTES=30

# ---- Bootstrap admin (used once by seed.py) ----
DEFAULT_ADMIN_USERID=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ---- CORS ----
# Comma-separated list of allowed frontend origins, or "*" for all (dev only)
CORS_ORIGINS=*

# ---- Optional SMTP, for emailing password-reset links ----
# Leave blank to have /api/auth/forgot-password return the reset link directly
# in the JSON response instead (handy for local dev / testing).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_RESET_URL=http://localhost:5500/reset-password.html
