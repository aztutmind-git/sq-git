# Copy this file to `.env` and fill in real values.

# ---- PostgreSQL ----
DATABASE_URL=postgresql+psycopg://syllabusquest:syllabusquest@localhost:5432/syllabusquest

# Optional: instead of putting the password in DATABASE_URL above, store it
# in your OS keychain via `python store_db_password.py`, then set this to
# true. Local dev only — see store_db_password.py for why. When enabled,
# DB_USER/DB_HOST/DB_PORT/DB_NAME below are used to build the connection
# string, and the password is looked up from the keychain at startup.
USE_KEYCHAIN_FOR_DB_PASSWORD=false
DB_USER=syllabusquest
DB_HOST=localhost
DB_PORT=5432
DB_NAME=syllabusquest

# ---- Auth ----
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
RESET_TOKEN_EXPIRE_MINUTES=30

# ---- Bootstrap admin (used once by seed.py) ----
DEFAULT_ADMIN_USERID=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ---- CORS ----
# Comma-separated list of allowed frontend origins, or "*" for all (dev only)
CORS_ORIGINS=*

# ---- Optional email API, for emailing password-reset links ----
# Uses Resend's HTTP API instead of SMTP, since PaaS hosts like Render block
# outbound SMTP ports on free plans. Leave blank to have
# /api/auth/forgot-password return the reset link directly in the JSON
# response instead (handy for local dev / testing).
RESEND_API_KEY=
EMAIL_FROM=
FRONTEND_RESET_URL=http://localhost:5500/reset-password.html
